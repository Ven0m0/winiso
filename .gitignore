# ─── Build artifacts ──────────────────────────────────────────────────────────
scripts/ISODIR/
*.iso
output/*
!output/.gitkeep

# ─── UUP input files (user-provided, never committed) ────────────────────────
uup_files/*
!uup_files/.gitkeep
.uup_cache/
**/.uup_cache/

# ─── Logs & traces ────────────────────────────────────────────────────────────
*.log
*.log[0-9]
*.trace
*.chk
*.retry

# ─── Temporary / scratch files ───────────────────────────────────────────────
*.tmp
*.bak
*.old
*.orig
*.rej
*~
\#*\#
__MACOSX/

# ─── Editor & IDE ─────────────────────────────────────────────────────────────
*.swp
*.swo
.vscode/
.idea/
*.iml
*.sublime-workspace
.omc/
.serena/
!.serena/project.yml
.codegraph/
hipocampus.config.json
MEMORY.md
USER.md
SCRATCHPAD*.md
WORKING*.md
TASK-QUEUE.md
memory/
knowledge/
plans/
tenants/

# ─── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.eggs/
dist/
build/
*.egg-info/

