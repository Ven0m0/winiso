# ─── Build artifacts ──────────────────────────────────────────────────────────
scripts/ISODIR/
*.iso
*.exe
*.dll
output/*
!output/.gitkeep

# ─── UUP input files (user-provided, never committed) ────────────────────────
uup_files/*
!uup_files/.gitkeep
.uup_cache/
**/.uup_cache/
uupdump/uup_download_macos.sh
uupdump/files/convert_config_macos

# ─── Logs & traces ────────────────────────────────────────────────────────────
*.log
*.log[0-9]
*.trace
*.chk
*.retry

# ─── Temporary / scratch files ───────────────────────────────────────────────
*.tmp
*.bak
*.old
*.orig
*.rej
*~
\#*\#
__MACOSX/

# ─── Editor & IDE ─────────────────────────────────────────────────────────────
*.swp
*.swo
.vscode/
.idea/
*.iml
*.sublime-workspace
.claude/settings.local.json
.omc/
.serena/
!.serena/project.yml
.codegraph/
.remember/

# ─── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.eggs/
dist/
build/
*.egg-info/
.coverage
htmlcov/
!uv.lock

# ─── OS-generated files ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*.lnk
$RECYCLE.BIN/
