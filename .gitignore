# ─── Build artifacts ──────────────────────────────────────────────────────────
scripts/ISODIR/
*.iso
output/*
!output/.gitkeep

# ─── UUP input files (user-provided, never committed) ────────────────────────
uup_files/*
!uup_files/.gitkeep

# ─── Logs & traces ────────────────────────────────────────────────────────────
*.log
*.log[0-9]
*.trace
*.chk
*.retry

# ─── Temporary / scratch files ───────────────────────────────────────────────
*.tmp
*.bak
*.old
*.orig
*.rej
*~
\#*\#
__MACOSX/

# ─── Editor & IDE ─────────────────────────────────────────────────────────────
*.swp
*.swo
.vscode/
.idea/
*.iml
*.sublime-workspace

# ─── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.eggs/
dist/
build/
*.egg-info/

# ─── OS-generated files ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
