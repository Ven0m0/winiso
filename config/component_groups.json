{
	"_about": "Component groups for toggleable debloating. Each group lists glob patterns from debloat_list.txt-style format. Pass group names to build via the GROUPS env var (space-separated) or to the Makefile target.",
	"groups": {
		"gaming": {
			"description": "Game launchers and entertainment apps (gaming-friendly profile keeps Xbox Game Pass; this is a more aggressive removal)",
			"patterns": [
				"*Xbox*",
				"*Solitaire*",
				"*CandyCrush*",
				"*BubbleWitch*",
				"*MarchofEmpires*",
				"*Minecraft*",
				"*Roblox*",
				"*HiddenCity*",
				"*CaesarsSlotsFreeCasino*"
			]
		},
		"productivity": {
			"description": "Productivity apps that ship with Windows but most users replace with Office or web apps",
			"patterns": [
				"*Clipchamp*",
				"*OfficeHub*",
				"*GetOffice*",
				"*MicrosoftStickyNotes*",
				"*Todos*",
				"*PowerAutomateDesktop*",
				"*PowerAutomate*",
				"*Whiteboard*"
			]
		},
