{
	"_about": "Component groups for toggleable debloating. Each group lists glob patterns from debloat_list.txt-style format. Pass group names to build via the GROUPS env var (space-separated) or to the Makefile target. Every pattern here also appears in debloat_list.txt (the flat list debloat_wim.sh always applies); keep both files in sync when adding patterns.",
	"groups": {
		"gaming": {
			"description": "Game launchers and entertainment apps (gaming-friendly profile keeps Xbox Game Pass; this is a more aggressive removal)",
			"patterns": [
				"*Xbox*",
				"*Solitaire*",
				"*CandyCrush*",
				"*BubbleWitch*",
				"*MarchofEmpires*",
				"*Minecraft*",
				"*Roblox*",
				"*HiddenCity*",
				"*CaesarsSlotsFreeCasino*"
			]
		},
